---
import "./InstallCommandTabs.scss";
---

<div class="install-tabs" data-install-tabs>
  <div class="install-tabs__topline">
    <div class="install-tabs__tablist" role="tablist" aria-label="Install command by distribution path">
      <button class="install-tabs__tab" type="button" role="tab" aria-selected="true" aria-controls="install-panel-homebrew" id="install-tab-homebrew" data-install-tab="homebrew">
        <span class="install-tabs__tab-name">Homebrew</span>
        <span class="install-tabs__tab-badge">Mac / Linux</span>
      </button>
      <button class="install-tabs__tab" type="button" role="tab" aria-selected="false" aria-controls="install-panel-scoop" id="install-tab-scoop" data-install-tab="scoop">
        <span class="install-tabs__tab-name">Scoop</span>
        <span class="install-tabs__tab-badge">Windows</span>
      </button>
      <button class="install-tabs__tab" type="button" role="tab" aria-selected="false" aria-controls="install-panel-source" id="install-tab-source" data-install-tab="source">
        <span class="install-tabs__tab-name">Source</span>
        <span class="install-tabs__tab-badge">Advanced</span>
      </button>
      <button class="install-tabs__tab" type="button" role="tab" aria-selected="false" aria-controls="install-panel-legacy" id="install-tab-legacy" data-install-tab="legacy">
        <span class="install-tabs__tab-name">Legacy</span>
        <span class="install-tabs__tab-badge">Migration</span>
      </button>
    </div>
  </div>

  <div class="install-tabs__command">
    <div class="install-tabs__panel" role="tabpanel" id="install-panel-homebrew" aria-labelledby="install-tab-homebrew" data-install-panel="homebrew">
      <div class="install-tabs__panel-intro">
        <p class="install-tabs__panel-title">Recommended install</p>
        <p class="install-tabs__panel-note">Recommended for most macOS and Linux users.</p>
      </div>

      <div class="install-tabs__blocks">
        <div class="install-tabs__block">
          <div class="install-tabs__block-topline">
            <span class="install-tabs__block-label">Install</span>
            <button class="install-tabs__copy" type="button" data-copy-command>[ copy ]</button>
          </div>
          <pre><span aria-hidden="true">$ </span><code>brew install webxsid/tap/crona</code></pre>
        </div>

      </div>
    </div>

    <div class="install-tabs__panel" role="tabpanel" id="install-panel-scoop" aria-labelledby="install-tab-scoop" data-install-panel="scoop" hidden>
      <div class="install-tabs__panel-intro">
        <p class="install-tabs__panel-title">Windows managed install</p>
        <p class="install-tabs__panel-note">Use Scoop on Windows. GitHub Releases remain the canonical binary source.</p>
      </div>

      <div class="install-tabs__blocks">
        <div class="install-tabs__block" data-copy-block>
          <div class="install-tabs__block-topline">
            <span class="install-tabs__block-label">Stable install</span>
            <button class="install-tabs__copy" type="button" data-copy-command>[ copy ]</button>
          </div>
          <pre><code>scoop bucket add webxsid https://github.com/webxsid/scoop-bucket
scoop install crona</code></pre>
        </div>

      </div>

    </div>

    <div class="install-tabs__panel" role="tabpanel" id="install-panel-source" aria-labelledby="install-tab-source" data-install-panel="source" hidden>
      <div class="install-tabs__panel-intro">
        <p class="install-tabs__panel-title">Advanced install</p>
        <p class="install-tabs__panel-note">For developers, contributors, and users who prefer building Crona from source.</p>
      </div>

      <div class="install-tabs__blocks">
        <div class="install-tabs__block">
          <div class="install-tabs__block-topline">
            <span class="install-tabs__block-label">Install</span>
            <button class="install-tabs__copy" type="button" data-copy-command>[ copy ]</button>
          </div>
          <pre><span aria-hidden="true">$ </span><code>go install github.com/webxsid/crona/...@latest</code></pre>
        </div>
      </div>

      <p class="install-tabs__panel-note" style="padding-top: 1ch;">Update by rerunning the same `go install` command.</p>
    </div>

    <div class="install-tabs__panel" role="tabpanel" id="install-panel-legacy" aria-labelledby="install-tab-legacy" data-install-panel="legacy" hidden>
      <div class="install-tabs__panel-intro">
        <p class="install-tabs__panel-title">Legacy installer</p>
        <p class="install-tabs__panel-note">This installer remains available for migration off older script installs. New installs should use Homebrew on macOS/Linux or Scoop on Windows.</p>
      </div>

      <div class="install-tabs__blocks">
        <div class="install-tabs__block">
          <div class="install-tabs__block-topline">
            <span class="install-tabs__block-label">macOS and Linux</span>
            <button class="install-tabs__copy" type="button" data-copy-command>[ copy ]</button>
          </div>
          <pre><span aria-hidden="true">$ </span><code>curl -fsSL https://github.com/webxsid/crona/releases/download/v1.6.0/install-crona-tui.sh | sh</code></pre>
        </div>

        <div class="install-tabs__block">
          <div class="install-tabs__block-topline">
            <span class="install-tabs__block-label">Windows</span>
            <button class="install-tabs__copy" type="button" data-copy-command>[ copy ]</button>
          </div>
          <pre><span aria-hidden="true">PS&gt; </span><code>Invoke-WebRequest "https://github.com/webxsid/crona/releases/download/v1.6.0/install-crona-tui.ps1" -OutFile "$env:TEMP\crona-install.ps1"
powershell -NoProfile -ExecutionPolicy Bypass -File "$env:TEMP\crona-install.ps1"</code></pre>
        </div>
      </div>

      <div class="install-tabs__legacy-actions">
        <a class="install-tabs__legacy-primary" href="/docs/migration/">Migration Guide →</a>
        <div class="install-tabs__legacy-secondary">
          <a href="/docs/install/">Install Guide</a>
          <a href="/changelog/">Release Notes</a>
        </div>
      </div>
    </div>
  </div>

  <div class="install-tabs__links" aria-label="Need help with installs">
    <span class="install-tabs__links-label">Need help?</span>
    <a class="install-tabs__links-primary" href="/docs/migration/">Migration Guide</a>
    <a href="/docs/install/">Install Guide</a>
    <a href="/changelog/">Release Notes</a>
  </div>
</div>

<script>
  import "./InstallCommandTabs.js";
</script>
