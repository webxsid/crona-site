---
import "./SiteHeader.scss";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props as Props;

const links = [
  { href: "/#install", label: "Install" },
  { href: "/docs/", label: "Docs" },
  { href: "/companions/", label: "Companions" },
  { href: "/changelog/", label: "Releases" },
  { href: "https://github.com/webxsid/crona", label: "GitHub" },
];

let githubStars = "—";
try {
  const response = await fetch("https://api.github.com/repos/webxsid/crona", {
    headers: { Accept: "application/vnd.github+json", "User-Agent": "crona-site" },
  });
  if (response.ok) {
    const repository = (await response.json()) as { stargazers_count?: number };
    if (typeof repository.stargazers_count === "number") githubStars = repository.stargazers_count.toLocaleString("en-US");
  }
} catch {
  // Keep the header buildable when GitHub is unavailable.
}

const normalizePath = (path: string) => path.replace(/\/+$/, "/");
const current = normalizePath(currentPath);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Crona home" aria-current={current === "/" ? "page" : undefined}>
      <span>&gt; crona</span>
    </a>
    <nav class="site-header__nav" id="primary-navigation" aria-label="Primary navigation">
      {
        links.map((link) => {
          const href = normalizePath(link.href);
          const isActive = href === "/" ? current === "/" : current.startsWith(href);

          return (
            <a
              class:list={{ "is-active": isActive }}
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              {...(link.href.startsWith("http") ? { rel: "noreferrer" } : {})}
            >
              {link.label === "GitHub" ? <><span>{link.label}</span><span class="site-header__stars" aria-label={`${githubStars} GitHub stars`}>★ {githubStars}</span></> : link.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
