---
import "./SiteHeader.scss";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props as Props;

const links = [
  { href: "/#install", label: "Install" },
  { href: "https://docs.crona.work/", label: "Docs", external: true },
  { href: "/mac/", label: "Mac app" },
  { href: "/changelog/", label: "Releases" },
  { href: "https://github.com/webxsid/crona", label: "GitHub" },
];

let githubStars = "—";
try {
  const response = await fetch("https://api.github.com/repos/webxsid/crona", {
    headers: { Accept: "application/vnd.github+json", "User-Agent": "crona-site" },
  });
  if (response.ok) {
    const repository = (await response.json()) as { stargazers_count?: number };
    if (typeof repository.stargazers_count === "number") githubStars = repository.stargazers_count.toLocaleString("en-US");
  }
} catch {
  // Keep the header buildable when GitHub is unavailable.
}

const normalizePath = (path: string) => path.replace(/\/+$/, "/");
const current = normalizePath(currentPath);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Crona home" aria-current={current === "/" ? "page" : undefined}>
      <span>&gt; crona</span>
    </a>
    <button class="site-header__menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-site-menu-toggle>
      <span class="site-header__menu-icon" aria-hidden="true"><i></i><i></i></span>
      <span class="site-header__sr-only">Open navigation</span>
    </button>
    <nav class="site-header__nav" id="primary-navigation" aria-label="Primary navigation">
      {
        links.map((link) => {
          const href = normalizePath(link.href);
          const isActive = href === "/" ? current === "/" : current.startsWith(href);

          return (
            <a
              class:list={{ "is-active": isActive }}
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              {...(link.href.startsWith("http") ? { rel: "noreferrer" } : {})}
            >
              {link.label === "GitHub" ? <><span>{link.label}</span><span class="site-header__stars" aria-label={`${githubStars} GitHub stars`}>★ {githubStars}</span></> : link.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-site-menu-toggle]");
  const header = document.querySelector(".site-header");
  const navigation = document.querySelector("#primary-navigation");

  if (toggle instanceof HTMLButtonElement && header && navigation) {
    const closeMenu = () => {
      header.removeAttribute("data-menu-open");
      toggle.setAttribute("aria-expanded", "false");
    };

    toggle.addEventListener("click", () => {
      const isOpen = header.hasAttribute("data-menu-open");
      if (isOpen) closeMenu();
      else {
        header.setAttribute("data-menu-open", "");
        toggle.setAttribute("aria-expanded", "true");
      }
    });

    navigation.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement) closeMenu();
    });

    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) closeMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
  }
</script>
