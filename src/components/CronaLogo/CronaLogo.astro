---
import CronaMark from "../CronaMark/CronaMark.astro";

interface Props {
  class?: string;
  decorative?: boolean;
  title?: string;
}

const {
  class: className,
  decorative = false,
  title = "Crona logo",
} = Astro.props as Props;
---

<CronaMark class={className} decorative={decorative} title={title} />
