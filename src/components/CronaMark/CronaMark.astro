---
import "./CronaMark.scss";

interface Props {
  class?: string;
  decorative?: boolean;
  title?: string;
  variant?: "dark" | "light" | "mono";
}

const {
  class: className,
  decorative = false,
  title = "Crona logo",
  variant = "dark",
} = Astro.props as Props;

const asset = {
  dark: "/brand/marks/crona-dark.svg",
  light: "/brand/marks/crona-light.svg",
  mono: "/brand/marks/crona-mono-outline.svg",
}[variant];
---

<img
  class={className}
  src={asset}
  alt={decorative ? "" : title}
  aria-hidden={decorative ? "true" : undefined}
  loading="eager"
  decoding="async"
/>
