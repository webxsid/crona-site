---
import "./SiteFooter.scss";

const links = [
  { href: "/docs/", label: "Docs" },
  { href: "/companions/", label: "Companions" },
  { href: "/changelog/", label: "Releases" },
  { href: "/support/", label: "Support" },
  { href: "/privacy/", label: "Privacy" },
  { href: "https://github.com/webxsid/crona", label: "GitHub", external: true },
];
---

<footer class="site-footer">
  <p class="site-footer__tagline">Local-first work tracking for developers.</p>
  <div class="site-footer__links">
    {
      links.map((link) => (
        <a class:list={{ "external-link": Boolean(link.external) }} href={link.href} {...(link.external ? { rel: "noreferrer" } : {})}>
          {link.label}
        </a>
      ))
    }
    <a class="external-link" href="https://webxsid.com" rel="noreferrer">
      Built by Sid
    </a>
  </div>
</footer>
