---
import { Image } from "astro:assets";
import dailyDashboard from "../../assets/screenshots/daily-dashboard.png";
import hero from "../../assets/screenshots/hero.png";
import issues from "../../assets/screenshots/issues.png";
import momentumDashboard from "../../assets/screenshots/momentum-dashboard.png";
import rollupDashboard from "../../assets/screenshots/rollup-dashboard.png";
import wellbeingDashboard from "../../assets/screenshots/wellbeing-dashboard.png";

const screenshots = {
  "daily-dashboard": dailyDashboard,
  hero,
  issues,
  "momentum-dashboard": momentumDashboard,
  "rollup-dashboard": rollupDashboard,
  "wellbeing-dashboard": wellbeingDashboard,
} as const;

type ScreenshotName = keyof typeof screenshots;

interface Props {
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  name: ScreenshotName;
  quality?: number;
  sizes?: string;
}

const {
  alt,
  class: className,
  loading = "lazy",
  name,
  quality = 88,
  sizes = "(min-width: 1024px) 50vw, 100vw",
} = Astro.props as Props;

const src = screenshots[name];
---

<Image
  alt={alt}
  class={className}
  densities={[1.5, 2]}
  format="webp"
  loading={loading}
  quality={quality}
  sizes={sizes}
  src={src}
/>
