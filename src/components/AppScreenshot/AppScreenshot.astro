---
import { Image } from "astro:assets";
import issues from "../../assets/screenshots/issues.png";
import momentum from "../../assets/screenshots/momentum.png";
import rollup from "../../assets/screenshots/rollup.png";
import summary from "../../assets/screenshots/summary.png";

const screenshots = {
  issues,
  momentum,
  rollup,
  summary,
} as const;

type ScreenshotName = keyof typeof screenshots;

interface Props {
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  name: ScreenshotName;
  quality?: number;
  sizes?: string;
}

const {
  alt,
  class: className,
  loading = "lazy",
  name,
  quality = 88,
  sizes = "(min-width: 1024px) 50vw, 100vw",
} = Astro.props as Props;

const src = screenshots[name];
---

<Image
  alt={alt}
  class={className}
  densities={[1.5, 2]}
  format="webp"
  loading={loading}
  quality={quality}
  sizes={sizes}
  src={src}
/>
