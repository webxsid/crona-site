---
import icon from "../../assets/companion/crona-mac-icon.png";
import "./CompanionSurface.scss";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={["companion-surface", { "companion-surface--compact": compact }]} aria-label="Crona for macOS menu bar surface preview">
  <div class="companion-surface__topbar">
    <span class="companion-surface__traffic"><i></i><i></i><i></i></span>
    <span>crona / menu bar</span>
    <span class="companion-surface__status">daemon: connected</span>
  </div>
  <div class="companion-surface__body">
    <div class="companion-surface__brand">
      <img src={icon.src} alt="" />
      <div><strong>Good afternoon.</strong><span>Tuesday · 14:32</span></div>
    </div>
    <div class="companion-surface__tabs"><span class="is-active">now</span><span>habits</span><span>wellbeing</span><span>stats</span></div>
    <div class="companion-surface__issue">
      <span class="companion-surface__issue-mark">›</span>
      <div><strong>Make the companion page useful</strong><span>crona-site / Dev · 45m</span></div>
      <span class="companion-surface__issue-action">focus</span>
    </div>
    <div class="companion-surface__metrics"><div><span>focus</span><strong>01:24:18</strong></div><div><span>today</span><strong>3 issues</strong></div><div><span>state</span><strong>working</strong></div></div>
  </div>
  <div class="companion-surface__hud"><span class="companion-surface__hud-dot"></span><strong>01:24:18</strong><span>Make the companion page useful</span><button type="button" disabled>pause</button></div>
</div>
