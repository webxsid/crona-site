---
import MacCapabilities from "../../components/MacCapabilities/MacCapabilities.astro";
import MacDownload from "../../components/MacDownload/MacDownload.astro";
import MacHero from "../../components/MacHero/MacHero.astro";
import MacRuntime from "../../components/MacRuntime/MacRuntime.astro";
import MacLayout from "../../layouts/MacLayout.astro";
import { loadGitHubReleases } from "../../lib/github-releases";
import { resolveMacReleases, type MacRelease } from "../../lib/mac-releases";
import "../_mac/mac.scss";

const repoUrl = "https://github.com/webxsid/crona-macos";
const releasesUrl = `${repoUrl}/releases`;
const releases = await loadGitHubReleases(repoUrl).catch(() => []);
const resolved = resolveMacReleases(releases);
const stable: MacRelease = resolved.stable ?? {
  version: "v1.0.0",
  releaseUrl: `${releasesUrl}/tag/v1.0.0`,
  publishedAt: null,
  prerelease: false,
};
const beta = resolved.beta;
const description =
  "Make the workday readable from the menu bar with Crona for macOS, backed by the same local runtime as Crona core.";
---

<MacLayout
  title="Keep the workday visible"
  description={description}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Crona for macOS",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "macOS 14.0 or later",
    softwareVersion: stable.version,
    downloadUrl: stable.downloadUrl ?? stable.releaseUrl,
    url: "https://crona.work/mac/",
  }}
>
  <!-- Hero: stable download first, with the latest beta kept discoverable. -->
  <MacHero stable={stable} beta={beta} />

  <!-- Capabilities: show the small actions the menu bar keeps close. -->
  <MacCapabilities />

  <!-- Runtime: explain how the Mac client shares the core local record. -->
  <MacRuntime />

  <!-- Download: repeat the stable-first installation path with release context. -->
  <MacDownload stable={stable} beta={beta} releasesUrl={releasesUrl} />
</MacLayout>
