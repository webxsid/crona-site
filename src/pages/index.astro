---
import BaseLayout from "../layouts/BaseLayout.astro";
import demoBg from "../assets/demo/demo-bg.jpg";
import openCronaMp4 from "../assets/demo/open-crona.mp4";
import openCronaWebm from "../assets/demo/open-crona.webm";
import sessionPomodoroMp4 from "../assets/demo/session-pomodoro.mp4";
import sessionPomodoroWebm from "../assets/demo/session-pomodoro.webm";
import sessionTimerMp4 from "../assets/demo/session-timer.mp4";
import sessionTimerWebm from "../assets/demo/session-timer.webm";
import "./_home/index.scss";
---

<BaseLayout
  title="Crona"
  pageTitle="Crona | Local-first work tracking for developers"
  description="Crona is a local-first work tracker for developers with issue-aware focus sessions, rest-aware Momentum, and a real background engine."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Crona",
      url: "https://crona.work",
      logo: "https://crona.work/logos/Logo Dark.png",
      sameAs: ["https://github.com/webxsid/crona"],
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Crona",
      url: "https://crona.work",
    },
  ]}
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__frame">
      <div class="home-hero__grid">
        <h1 id="home-title" class="home-hero__sr-title">Crona</h1>
        <div class="home-hero__intro">
          <p class="home-hero__descriptor"><span>&gt;</span> local-first work tracking for developers</p>
          <h2 class="home-hero__headline">Make the workday readable.</h2>
          <p class="home-hero__lede">Plan what matters, stay with it, and leave a useful record — without leaving your terminal or your data.</p>
          <div class="home-hero__actions">
            <button class="button" type="button" data-install-open><span>[i]</span> install crona</button>
            <a class="button button--secondary" href="https://docs.crona.work/"><span>[d]</span> view docs</a>
          </div>
        </div>
        <div class="home-hero__visual">
          <div class="home-video-stage">
            <div class="home-video-frame">
              <div class="home-video-frame__context"><span class="home-video-frame__lights"><i></i><i></i><i></i></span><strong>Crona · daily — 192×53</strong><span>repo: crona-site / stream: Dev</span><span>engine: ok</span></div>
              <video data-demo-video data-timer-webm={sessionTimerWebm} data-timer-mp4={sessionTimerMp4} data-pomodoro-webm={sessionPomodoroWebm} data-pomodoro-mp4={sessionPomodoroMp4} controls muted playsinline preload="metadata" poster={demoBg.src} aria-label="Recorded Crona terminal workflow">
                <source data-demo-webm src={openCronaWebm} type="video/webm" />
                <source data-demo-mp4 src={openCronaMp4} type="video/mp4" />
              </video>
              <div class="home-video-controls" data-demo-controls aria-label="Video controls">
                <button class="home-video-controls__play" type="button" data-demo-toggle aria-label="Play video">play</button>
                <span class="home-video-controls__time" data-demo-current>00:00</span>
                <input class="home-video-controls__seek" data-demo-seek type="range" min="0" max="100" value="0" step="0.1" aria-label="Video progress" />
                <span class="home-video-controls__time" data-demo-duration>00:00</span>
                <button type="button" data-demo-mute aria-label="Unmute video" aria-pressed="false">sound off</button>
              </div>
              <button class="home-video-frame__play" type="button" data-demo-play aria-label="Play the Crona workflow again">play again</button>
              <div class="home-video-frame__footer"><span data-demo-status aria-live="polite">Open TUI · recorded workflow</span><span>local daemon: connected</span><span>select a flow below</span></div>
            </div>
          </div>
          <div class="home-demo-flows" aria-label="Crona demo flows">
            <button class="is-active" type="button" data-demo-flow="open" aria-pressed="true" style="--demo-progress: 0%"><span class="home-demo-flow__key">[1]</span><span class="home-demo-flow__label">open tui</span><span class="home-demo-flow__progress" aria-hidden="true"></span></button>
            <button type="button" data-demo-flow="timer" aria-pressed="false" style="--demo-progress: 0%"><span class="home-demo-flow__key">[2]</span><span class="home-demo-flow__label">start timer</span><span class="home-demo-flow__progress" aria-hidden="true"></span></button>
            <button type="button" data-demo-flow="pomodoro" aria-pressed="false" style="--demo-progress: 0%"><span class="home-demo-flow__key">[3]</span><span class="home-demo-flow__label">run pomodoro</span><span class="home-demo-flow__progress" aria-hidden="true"></span></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-features home-reveal" id="features" aria-labelledby="features-title">
    <div class="home-section-heading"><h2 id="features-title">A workday that leaves a trail.</h2><p>Crona connects what you meant to do, what you focused on, and what actually moved.</p></div>
    <div class="home-workflow" aria-label="Crona workflow">
      <article class="home-workflow__step"><span class="home-workflow__key">[1]</span><h3>plan</h3><p>Pull issues and habits into one day you can see.</p><span class="home-workflow__meta">issues / habits / sqlite</span></article>
      <article class="home-workflow__step"><span class="home-workflow__key">[2]</span><h3>focus</h3><p>Start a session with the work already attached.</p><span class="home-workflow__meta">session / timer / tui</span></article>
      <article class="home-workflow__step"><span class="home-workflow__key">[3]</span><h3>review</h3><p>See what moved. Keep the context.</p><span class="home-workflow__meta">history / momentum / reports</span></article>
    </div>
    <div class="home-workflow__footer"><span>&gt; plan → focus → review / one local record</span><a href="https://docs.crona.work/">read the docs <span aria-hidden="true">→</span></a></div>
  </section>

  <section class="home-local home-reveal" aria-labelledby="local-title">
    <div class="home-local__copy">
      <h2 id="local-title">Nothing to sync before you start.</h2>
      <p>Crona keeps the day in SQLite, runs through a local daemon, and stays usable from the TUI and CLI.</p>
    </div>
    <div class="home-local__details" aria-label="Crona local runtime">
      <div><span>storage</span><strong>sqlite</strong></div>
      <div><span>runtime</span><strong>local daemon</strong></div>
      <div><span>surfaces</span><strong>tui + cli</strong></div>
      <div><span>companion</span><strong>macos</strong></div>
    </div>
    <div class="home-local__links"><a href="https://docs.crona.work/">read the docs <span aria-hidden="true">→</span></a><a href="/companions/">open the macOS companion <span aria-hidden="true">→</span></a></div>
  </section>

  <section class="home-closing home-reveal" aria-labelledby="closing-title">
    <h2 id="closing-title">Give the day somewhere to go.</h2>
    <p>Install Crona, open the TUI, and make the next session easier to find.</p>
    <div class="home-hero__actions"><button class="button" type="button" data-install-open><span>[i]</span> install crona</button><a class="button button--secondary" href="https://docs.crona.work/"><span>[d]</span> read the docs</a></div>
  </section>

  <div class="install-modal" data-install-modal hidden>
    <div class="install-modal__backdrop" data-install-close></div>
    <section class="install-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="install-modal-title" aria-describedby="install-modal-description" tabindex="-1">
      <div class="install-modal__topline">
        <div>
          <span class="install-modal__eyebrow">setup / crona</span>
          <h2 id="install-modal-title">Install Crona</h2>
        </div>
        <button class="install-modal__close" type="button" aria-label="Close installation instructions" data-install-close>×</button>
      </div>
      <p class="install-modal__description" id="install-modal-description">Choose your platform. The core stays local and the commands install the current release path.</p>
      <div class="install-modal__tabs" role="tablist" aria-label="Installation platform">
        <button type="button" role="tab" aria-selected="true" aria-controls="install-panel-macos" id="install-tab-macos" data-install-platform="macos">macOS</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="install-panel-linux" id="install-tab-linux" data-install-platform="linux">Linux</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="install-panel-windows" id="install-tab-windows" data-install-platform="windows">Windows</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="install-panel-go" id="install-tab-go" data-install-platform="go">Go</button>
      </div>
      <div class="install-modal__panels">
        <div class="install-modal__panel" role="tabpanel" id="install-panel-macos" aria-labelledby="install-tab-macos" data-install-panel="macos">
          <p>Install with Homebrew:</p>
          <div class="install-modal__command"><code>brew install webxsid/tap/crona</code><button type="button" data-install-copy>[ copy ]</button></div>
          <a class="install-modal__companion" href="/companions/">Need a native surface? Download the macOS Companion <span aria-hidden="true">→</span></a>
        </div>
        <div class="install-modal__panel" role="tabpanel" id="install-panel-linux" aria-labelledby="install-tab-linux" data-install-panel="linux" hidden>
          <p>Install with Homebrew:</p>
          <div class="install-modal__command"><code>brew install webxsid/tap/crona</code><button type="button" data-install-copy>[ copy ]</button></div>
        </div>
        <div class="install-modal__panel" role="tabpanel" id="install-panel-windows" aria-labelledby="install-tab-windows" data-install-panel="windows" hidden>
          <p>Install with Scoop:</p>
          <div class="install-modal__command"><code>scoop bucket add webxsid https://github.com/webxsid/scoop-bucket
scoop install crona</code><button type="button" data-install-copy>[ copy ]</button></div>
        </div>
        <div class="install-modal__panel" role="tabpanel" id="install-panel-go" aria-labelledby="install-tab-go" data-install-panel="go" hidden>
          <p>Install from source with Go:</p>
          <div class="install-modal__command"><code>go install github.com/webxsid/crona/...@latest</code><button type="button" data-install-copy>[ copy ]</button></div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script src="./_home/index.js"></script>
