---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppScreenshot from "../components/AppScreenshot/AppScreenshot.astro";
import InstallCommandTabs from "../components/InstallCommandTabs/InstallCommandTabs.astro";
import "./_home/index.scss";
---

<BaseLayout
  title="Crona"
  pageTitle="Crona | Local-first work tracking for developers"
  description="Crona helps developers plan issues, run issue-scoped focus sessions, review Rollup and Wellbeing, and keep checkout context local from one system."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Crona",
      url: "https://crona.work",
      logo: "https://crona.work/logos/Logo Dark.png",
      sameAs: ["https://github.com/webxsid/crona"],
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Crona",
      url: "https://crona.work",
    },
  ]}
>
  <section class="container section section--hero home-hero">
    <div class="home-hero__stack">
      <div class="home-hero__copy flow">
        <p class="eyebrow">terminal-native work tracking</p>
        <h1>Local-first work tracking for people who live in the terminal.</h1>
        <p class="home-hero__lede">
          Plan issues, run issue-scoped focus sessions, review Rollup and Wellbeing, and keep a readable record of
          what actually happened.
        </p>
        <p class="home-hero__body">
          Crona keeps planning, checkout context, modal dialogs, check-ins, and exports in one local system so the day
          does not disappear into tabs, scratch notes, and half-finished context switches.
        </p>
      </div>

      <div class="home-hero__actions">
        <a class="button" href="/docs/getting-started/">See how it works</a>
        <a class="button button--secondary" href="/docs/">Browse docs</a>
      </div>
      <div class="home-hero__install">
        <InstallCommandTabs />
      </div>


      <div class="home-hero__visual" aria-label="Crona Daily dashboard preview">
        <div class="home-hero__frame">
          <AppScreenshot
            name="daily-dashboard"
            alt="Crona Daily dashboard showing compact momentum signals and issue summaries"
            loading="eager"
            quality={96}
            sizes="(min-width: 1280px) 1080px, (min-width: 1024px) 72vw, 100vw"
          />
        </div>

        <!-- <div class="home-hero__note"> -->
        <!--   <p>Today’s loop</p> -->
        <!--   <ul> -->
        <!--     <li>choose context</li> -->
        <!--     <li>start focus</li> -->
        <!--     <li>review the day</li> -->
        <!--   </ul> -->
        <!-- </div> -->
      </div>
    </div>
  </section>

  <section class="container section home-loop">
    <div class="home-section-heading flow">
      <p class="eyebrow">workflow</p>
      <h2>One loop, three surfaces.</h2>
      <p>
        The point is not to track everything. The point is to make planning, focus, and review feel like the same day
        instead of three different systems.
      </p>
    </div>

    <div class="home-loop__grid">
      <article class="home-loop__step">
        <span>01</span>
        <h3>Plan the day</h3>
        <p>Pick the repo, stream, and issues that actually matter before the first session starts.</p>
      </article>

      <article class="home-loop__step">
        <span>02</span>
        <h3>Run issue-scoped focus</h3>
        <p>Each issue carries its timer type, so the cadence follows the work instead of a global setting.</p>
      </article>

      <article class="home-loop__step">
        <span>03</span>
        <h3>Read what happened</h3>
        <p>Use Rollup, check-ins, exports, and Wellbeing signals to make tomorrow easier to start.</p>
      </article>
    </div>
  </section>

  <section class="container section home-surfaces">
    <div class="home-section-heading flow">
      <p class="eyebrow">product surfaces</p>
      <h2>Built around the way work actually unfolds.</h2>
    </div>

    <div class="home-surface home-surface--issues">
      <div class="home-surface__media">
        <AppScreenshot
          name="issues"
          alt="Crona Issues workspace showing issue-scoped timing and spent time"
          sizes="(min-width: 1024px) 54vw, 100vw"
        />
      </div>
      <div class="home-surface__copy flow">
        <p class="home-surface__label">Issues workspace</p>
        <h3>Shape work before it turns into noise.</h3>
        <p>
          Use repos, streams, issue timer types, statuses, and dates to decide what is actually in play. The planning
          surface is there to clarify the day, not to create another list you feel guilty about later.
        </p>
        <a href="/docs/issues-and-planning/">Read planning docs</a>
      </div>
    </div>

    <div class="home-surface home-surface--rollup">
      <div class="home-surface__copy flow">
        <p class="home-surface__label">Rollup dashboard</p>
        <h3>See focus and calendar together.</h3>
        <p>
          Rollup keeps the focus graph next to the calendar so the current day stays readable, with the Breakdown pane
          ready when you want the details.
        </p>
        <a href="/docs/screenshots-and-walkthrough/">Read the walkthrough</a>
      </div>
      <div class="home-surface__media">
        <AppScreenshot
          name="rollup-dashboard"
          alt="Crona Rollup dashboard showing the focus graph beside the calendar and the Breakdown pane"
          sizes="(min-width: 1024px) 54vw, 100vw"
        />
      </div>
    </div>

    <div class="home-surface home-surface--momentum">
      <div class="home-surface__media">
        <AppScreenshot
          name="momentum-dashboard"
          alt="Crona Momentum dashboard showing custom cards, week labels, and paused history states"
          sizes="(min-width: 1024px) 54vw, 100vw"
        />
      </div>
      <div class="home-surface__copy flow">
        <p class="home-surface__label">Momentum dashboard</p>
        <h3>Keep the long view custom.</h3>
        <p>
          Momentum shows the custom history cards, descriptions, and week prefixes that keep the wellbeing story
          readable without turning it back into a generic streak view.
        </p>
        <a href="/docs/check-ins-and-wellbeing/">Read wellbeing docs</a>
      </div>
    </div>

    <div class="home-surface home-surface--wellbeing">
      <div class="home-surface__copy flow">
        <p class="home-surface__label">Wellbeing dashboard</p>
        <h3>Keep the work log human.</h3>
        <p>
          Check-ins, energy, sleep, compact Daily signals, burnout history, and custom-only Momentum help you notice
          patterns that a finished checklist would never show you on its own.
        </p>
        <a href="/docs/check-ins-and-wellbeing/">Read wellbeing docs</a>
      </div>
      <div class="home-surface__media">
        <AppScreenshot
          name="wellbeing-dashboard"
          alt="Crona Wellbeing dashboard showing the configurable Metrics Window, details pane, and custom Momentum"
          sizes="(min-width: 1024px) 54vw, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="container section home-close">
    <div class="home-close__panel">
      <div class="home-close__copy flow">
        <p class="eyebrow">next step</p>
        <h2>Install it, then keep the manual close.</h2>
        <p>
          Start from the install guide, learn the workflow in docs, and use GitHub for releases and issue tracking. The
          website stays stable even when the app keeps moving.
        </p>
      </div>

      <div class="home-close__links">
        <a href="/docs/install/">
          <strong>Install and runtime guide</strong>
          <span>Platform setup, shell completions, alerts, exports, and update basics.</span>
        </a>
        <a href="/docs/">
          <strong>Documentation</strong>
          <span>Start with getting started, then move into daily workflows and reference pages.</span>
        </a>
        <a href="/changelog/">
          <strong>Releases</strong>
          <span>Browse the latest release cards here, then jump to GitHub for the raw notes and artifacts.</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
