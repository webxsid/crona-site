---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppScreenshot from "../components/AppScreenshot/AppScreenshot.astro";
import InstallCommands from "../components/InstallCommands/InstallCommands.astro";
import InstallModal from "../components/InstallModal/InstallModal.astro";
import LotrOverlay from "../components/LotrOverlay/LotrOverlay.astro";
import MeshGradient from "../components/MeshGradient/MeshGradient.astro";
import RuntimeArchitecture from "../components/RuntimeArchitecture/RuntimeArchitecture.astro";
import WorkspaceCard from "../components/WorkspaceCard/WorkspaceCard.astro";
import WorkspaceCarousel from "../components/WorkspaceCarousel/WorkspaceCarousel.astro";
import WorkflowDemo from "../components/WorkflowDemo/WorkflowDemo.astro";
import "./_home/index.scss";
---

<BaseLayout
  title="Crona"
  pageTitle="Crona | Make the workday readable"
  description="Make the workday readable with Crona, a local-first tracker for issues, focus sessions, habits, and history."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Crona",
      url: "https://crona.work",
      logo: "https://crona.work/brand/marks/crona-dark.svg",
      sameAs: ["https://github.com/webxsid/crona"],
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Crona",
      url: "https://crona.work",
    },
  ]}
>
  <!-- Hero: introduce Crona and its local workday record. -->
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__frame">
      <div class="home-hero__grid">
        <h1 id="home-title" class="home-hero__sr-title">Crona</h1>
        <div class="home-hero__intro">
          <h2 class="home-hero__headline">Make the workday readable.</h2>
          <p class="home-hero__sub-headline">
            A local work tracker for planning the day, focusing on work, and reviewing what
            happened. Crona is built for everyone who want to keep the context of their work without
            relying on a cloud service.
          </p>
          <div class="home-hero__actions">
            <button class="button" type="button" data-install-open
              ><span>[i]</span> install crona</button
            >
            <a class="button button--secondary" href="https://docs.crona.work/"
              ><span>[d]</span> view docs</a
            >
          </div>
        </div>
        <div class="home-hero__visual">
          <WorkflowDemo variant="core" />
        </div>
      </div>
    </div>
  </section>

  <!-- Workspace views: show the same record through three focused surfaces. -->
  <section class="home-features home-reveal" id="features" aria-labelledby="features-title">
    <div class="home-section-heading">
      <h2 id="features-title">One record. Three ways to read it.</h2>
      <p>
        Look back at where your time went, see what you’re building toward, or get a clear picture
        of the day.
      </p>
    </div>
    <div class="home-workspace-screen">
      <div class="home-workspace-screen__canvas" aria-label="Crona workspace views" role="group">
        <MeshGradient class="home-workspace-screen__mesh--desktop" variant="workspace" />
        <button
          class="home-workspace-screen__image home-workspace-screen__image--momentum"
          type="button"
          data-workspace-open="0"
          aria-label="Enlarge Momentum view"
        >
          <AppScreenshot
            name="momentum"
            alt="Crona Momentum terminal view showing focus patterns and habit progress across a 30-day window"
            loading="eager"
            sizes="(min-width: 1024px) 58vw, 100vw"
          />
        </button>
        <button
          class="home-workspace-screen__image home-workspace-screen__image--rollup"
          type="button"
          data-workspace-open="1"
          aria-label="Enlarge Rollup view"
        >
          <AppScreenshot
            name="rollup"
            alt="Crona Rollup terminal view comparing estimated and logged focus across a date range"
            loading="eager"
            sizes="(min-width: 1024px) 48vw, 100vw"
          />
        </button>
        <button
          class="home-workspace-screen__image home-workspace-screen__image--summary"
          type="button"
          data-workspace-open="2"
          aria-label="Enlarge Summary view"
        >
          <AppScreenshot
            name="summary"
            alt="Crona Summary terminal view showing focus, issues, habits, agenda, wellbeing, and momentum"
            loading="eager"
            sizes="(min-width: 1024px) 48vw, 100vw"
          />
        </button>
        <WorkspaceCard
          variant="momentum"
          label="momentum"
          description="Track habits and focus across the weeks."
        />
        <WorkspaceCard
          variant="rollup"
          label="rollup"
          description="Compare estimated time with logged focus."
        />
        <WorkspaceCard
          variant="summary"
          label="summary"
          description="Reconstruct the day without reconstructing it from memory."
        />
      </div>
    </div>
    <div class="home-workflow__footer">
      <span>rollup / momentum / summary · one local record</span><a href="https://docs.crona.work/"
        >read the docs <span aria-hidden="true">→</span></a
      >
    </div>
  </section>

  <!-- Workspace viewer: enlarged screenshots with keyboard and button navigation. -->
  <WorkspaceCarousel />

  <!-- Runtime architecture: every client reads and writes through the local daemon. -->
  <section class="home-local home-reveal" aria-labelledby="local-title">
    <div class="home-local__copy">
      <h2 id="local-title">
        <button
          class="home-local__lotr"
          type="button"
          aria-expanded="false"
          aria-haspopup="dialog"
          aria-controls="lotr-overlay"
          data-lotr-toggle
        >
          One daemon to rule them all.
        </button>
      </h2>
      <p>
        Crona keeps everything local and in one place. The TUI, CLI, and Mac app all talk to the
        same daemon, sharing your issues, sessions, habits, and history.
      </p>
    </div>
    <RuntimeArchitecture />
    <div class="home-local__links">
      <a href="https://docs.crona.work/">read the docs <span aria-hidden="true">→</span></a><a
        href="/mac/">open the Mac app <span aria-hidden="true">→</span></a
      >
    </div>
  </section>

  <!-- Easter egg: the optional LOTR reveal attached to the daemon headline. -->
  <LotrOverlay />

  <!-- Final install CTA: give the user the shortest path from reading to running Crona. -->
  <section class="home-closing home-reveal" aria-labelledby="closing-title">
    <div class="home-closing__copy">
      <h2 id="closing-title">Put the next session on record.</h2>
      <p>Crona is local, account-free, and ready when you are. Install it and get to work.</p>
      <div class="home-hero__actions">
        <button class="button" type="button" data-install-open
          ><span>[i]</span> install crona</button
        ><a class="button button--secondary" href="https://docs.crona.work/"
          ><span>[d]</span> read the docs</a
        >
      </div>
    </div>
    <InstallCommands />
  </section>

  <!-- Install modal: platform-specific setup opened by the page's install actions. -->
  <InstallModal />
</BaseLayout>

<script src="./_home/index.js"></script>
