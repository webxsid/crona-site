---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppScreenshot from "../components/AppScreenshot/AppScreenshot.astro";
import InstallCommandTabs from "../components/InstallCommandTabs/InstallCommandTabs.astro";
import "./_home/index.scss";
---

<BaseLayout
  title="Crona"
  pageTitle="Crona | Local-first work tracking for developers"
  description="Crona is a local-first work tracker for developers who live in the terminal."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Crona",
      url: "https://crona.work",
      logo: "https://crona.work/logos/Logo Dark.png",
      sameAs: ["https://github.com/webxsid/crona"],
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Crona",
      url: "https://crona.work",
    },
  ]}
>
  <section class="container section section--hero home-hero">
    <div class="home-hero__stack">
      <div class="home-hero__copy flow">
        <p class="eyebrow">terminal-native work tracking</p>
        <h1>Local-first work tracking for developers who live in the terminal.</h1>
        <p class="home-hero__lede">Plan work, run focused sessions, and review what actually got done.</p>
        <p class="home-hero__body">
          Crona keeps planning, focus sessions, and daily review in one place so you do not bounce between browser
          tabs, dashboards, and note-taking apps just to understand your day.
        </p>
      </div>

      <div class="home-hero__actions">
        <a class="button" href="/docs/getting-started/">See how it works</a>
        <a class="button button--secondary" href="/docs/">Browse docs</a>
      </div>
      <div class="home-hero__install">
        <InstallCommandTabs />
      </div>


      <div class="home-hero__visual" aria-label="Crona Daily dashboard preview">
        <div class="home-hero__frame">
          <AppScreenshot
            name="daily-dashboard"
            alt="Crona Daily dashboard showing compact momentum signals and issue summaries"
            loading="eager"
            quality={96}
            sizes="(min-width: 1280px) 1080px, (min-width: 1024px) 72vw, 100vw"
          />
        </div>

        <!-- <div class="home-hero__note"> -->
        <!--   <p>Today’s loop</p> -->
        <!--   <ul> -->
        <!--     <li>choose context</li> -->
        <!--     <li>start focus</li> -->
        <!--     <li>review the day</li> -->
        <!--   </ul> -->
        <!-- </div> -->
      </div>
    </div>
  </section>

  <section class="container section home-why">
    <div class="home-why__copy flow">
      <p class="eyebrow">why crona exists</p>
      <h2>My day starts and ends in the terminal.</h2>
      <p>
        I got tired of splitting my work across browser tabs, timers, task boards, and notes just to keep track of
        what I planned and what actually happened.
      </p>
      <p>
        I wanted planning, focus, and review to live where I already work. So I built Crona: a local-first work
        tracker that feels like part of the development workflow instead of another system to maintain.
      </p>
    </div>
  </section>

  <section class="container section home-loop">
    <div class="home-section-heading flow">
      <p class="eyebrow">what it solves</p>
      <h2>Planning, focus, and review should feel like one workflow.</h2>
      <p>
        You should be able to see what you planned, what you worked on, and where your time actually went without
        stitching together three separate tools.
      </p>
    </div>

    <div class="home-loop__grid">
      <article class="home-loop__step">
        <span>01</span>
        <h3>Know what matters first</h3>
        <p>Pick the repo, stream, and issues that should shape the day before you start working.</p>
      </article>

      <article class="home-loop__step">
        <span>02</span>
        <h3>Keep focus tied to real work</h3>
        <p>Sessions attach to the issue itself, so the timer follows the work instead of floating free.</p>
      </article>

      <article class="home-loop__step">
        <span>03</span>
        <h3>See what actually happened</h3>
        <p>Review the day without guessing: what you planned, what you finished, and where the time went.</p>
      </article>
    </div>
  </section>

  <section class="container section home-surfaces">
    <div class="home-section-heading flow">
      <p class="eyebrow">product surfaces</p>
      <h2>Work moves between planning, coding, and review.</h2>
      <p>Crona keeps those parts connected instead of making you switch tools every time the day changes shape.</p>
    </div>

    <div class="home-surface home-surface--issues">
      <div class="home-surface__media">
        <AppScreenshot
          name="issues"
          alt="Crona Issues workspace showing issue-scoped timing and spent time"
          sizes="(min-width: 1024px) 54vw, 100vw"
        />
      </div>
      <div class="home-surface__copy flow">
        <p class="home-surface__label">Issues workspace</p>
        <h3>Know what is in play before the session starts.</h3>
        <p>
          Repos, streams, statuses, dates, and timer types help you see the real shape of the day instead of another
          oversized list.
        </p>
        <a href="/docs/issues-and-planning/">Read about issue planning</a>
      </div>
    </div>

    <div class="home-surface home-surface--rollup">
      <div class="home-surface__copy flow">
        <p class="home-surface__label">Rollup dashboard</p>
        <h3>Review workload without losing the calendar.</h3>
        <p>See focus patterns, calendar context, and the Breakdown pane together when you want the full picture.</p>
        <a href="/docs/screenshots-and-walkthrough/">Read the walkthrough</a>
      </div>
      <div class="home-surface__media">
        <AppScreenshot
          name="rollup-dashboard"
          alt="Crona Rollup dashboard showing the focus graph beside the calendar and the Breakdown pane"
          sizes="(min-width: 1024px) 54vw, 100vw"
        />
      </div>
    </div>

    <div class="home-surface home-surface--momentum">
      <div class="home-surface__media">
        <AppScreenshot
          name="momentum-dashboard"
          alt="Crona Momentum dashboard showing custom cards, week labels, and paused history states"
          sizes="(min-width: 1024px) 54vw, 100vw"
        />
      </div>
      <div class="home-surface__copy flow">
        <p class="home-surface__label">Momentum dashboard</p>
        <h3>See whether you are showing up consistently.</h3>
        <p>
          Momentum keeps your longer-running history readable without turning it into a generic streak counter.
        </p>
        <a href="/docs/check-ins-and-wellbeing/">Read about Momentum</a>
      </div>
    </div>

    <div class="home-surface home-surface--wellbeing">
      <div class="home-surface__copy flow">
        <p class="home-surface__label">Wellbeing dashboard</p>
        <h3>Notice patterns a checklist would miss.</h3>
        <p>Check-ins, energy, sleep, and burnout signals give you a human read on the work you have been doing.</p>
        <a href="/docs/check-ins-and-wellbeing/">Read about wellbeing</a>
      </div>
      <div class="home-surface__media">
        <AppScreenshot
          name="wellbeing-dashboard"
          alt="Crona Wellbeing dashboard showing the configurable Metrics Window, details pane, and custom Momentum"
          sizes="(min-width: 1024px) 54vw, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="container section home-close">
    <div class="home-close__panel">
      <div class="home-close__copy flow">
        <p class="eyebrow">next step</p>
        <h2>Install it, then keep the docs close.</h2>
        <p>Use the install guide first, then read the migration pages if you are moving from an older install.</p>
      </div>

      <div class="home-close__links">
        <a href="/install/">
          <strong>Install hub</strong>
          <span>Package-manager tabs, fallback scripts, and pinned release assets.</span>
        </a>
        <a href="/docs/">
          <strong>Documentation</strong>
          <span>Start with getting started, then move into install, migration, and reference pages.</span>
        </a>
        <a href="/docs/migration/">
          <strong>Migration guide</strong>
          <span>Move a legacy install to Homebrew, Go source installs, or Winget without losing state.</span>
        </a>
        <a href="/changelog/">
          <strong>Releases</strong>
          <span>Browse the latest release cards, then jump to GitHub for the raw notes and artifacts.</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
