---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsSidebar from "../../components/DocsSidebar/DocsSidebar.astro";
import { categorizeDocs, sortDocs } from "./_shared/docs.js";
import "./_index/index.scss";

const docs = await getCollection("docs");
const sortedDocs = sortDocs(docs);
const docGroups = categorizeDocs(sortedDocs);
const siteUrl = Astro.site ?? new URL("https://crona.work");
const docsUrl = new URL("/docs/", siteUrl).href;
---

<BaseLayout
  title="Documentation"
  pageTitle="Crona documentation"
  description="Browse Crona docs for setup, migration, issue-aware focus sessions, rest-aware Momentum, alerts, exports, automation, and reference material."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "Crona Documentation",
      url: docsUrl,
      isPartOf: {
        "@type": "WebSite",
        "@id": "https://crona.work/",
        name: "Crona",
      },
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://crona.work/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Docs",
          item: docsUrl,
        },
      ],
    },
  ]}
>
  <section class="container section docs-page">
    <div class="docs-layout">
      <DocsSidebar groups={docGroups} activeDocId="__overview__" />

      <div class="docs-main flow">
        <header class="page-header flow measure">
          <p class="eyebrow">Docs</p>
          <h1>Crona documentation</h1>
          <p class="docs-intro">
            Crona’s docs are organized like a working manual: start with the runtime model, move into daily workflows,
            then use the operational and reference sections when you need specifics.
          </p>
        </header>

        <section class="docs-home-start flow" aria-labelledby="docs-home-start">
          <div class="docs-home-group__header flow">
            <p class="docs-home-group__label">Start here</p>
            <h2 id="docs-home-start">The fastest path into Crona.</h2>
          </div>

          <div class="link-list">
            <a href="/docs/getting-started/">
              <strong>Getting Started</strong>
              <span>Learn what Crona is, who it fits, and how the local runtime fits together.</span>
            </a>
            <a href="/docs/install/">
              <strong>Install</strong>
              <span>See managed installs, runtime paths, completions, alerts, and update basics.</span>
            </a>
            <a href="/docs/migration/">
              <strong>Migration</strong>
              <span>Move from legacy scripts to Homebrew, Scoop, or Go source installs without losing data.</span>
            </a>
            <a href="/docs/features-overview/">
              <strong>Features Overview</strong>
              <span>Scan the main workflows across planning, focus, Rollup, Wellbeing, and Momentum.</span>
            </a>
            <a href="/docs/screenshots-and-walkthrough/">
              <strong>Screenshots and Walkthrough</strong>
              <span>Preview the public workflow with the current Daily, Rollup, Momentum, and Wellbeing surfaces.</span>
            </a>
          </div>
        </section>

        <div class="docs-home-sections">
          {docGroups.map((group) => (
            <section class="docs-home-group flow" aria-labelledby={`docs-home-${group.id}`}>
              <div class="docs-home-group__header flow">
                <p class="docs-home-group__label">{group.title}</p>
                <h2 id={`docs-home-${group.id}`}>{group.description}</h2>
              </div>

              <div class="link-list">
                {group.items.map((doc) => (
                  <a href={`/docs/${doc.id}/`}>
                    <strong>{doc.data.title}</strong>
                    {doc.data.description && <span>{doc.data.description}</span>}
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
