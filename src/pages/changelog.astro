---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import "./_changelog/changelog.scss";

const repoUrl = "https://github.com/webxsid/crona";
const releasesUrl = `${repoUrl}/releases`;
const apiUrl = "https://api.github.com/repos/webxsid/crona/releases?per_page=10";
const dateFormatter = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
  timeZone: "UTC",
});

type GitHubRelease = {
  draft: boolean;
  prerelease: boolean;
  tag_name?: string | null;
  name?: string | null;
  html_url: string;
  published_at?: string | null;
  body?: string | null;
};

type Semver = {
  major: number;
  minor: number;
  patch: number;
  prerelease: boolean;
};

type ReleaseStatus = "stable" | "pre-release";
type ReleaseBump = "major" | "minor" | "patch" | "pre-release" | "release";

type ReleaseCard = {
  version: string;
  title: string;
  headline: string;
  url: string;
  publishedAt: Date | null;
  status: ReleaseStatus;
  summary: string;
  latest: boolean;
  latestStable: boolean;
  bump: ReleaseBump;
};

function stripMarkdown(text = "") {
  return text
    .replace(/\r/g, "")
    .replace(/^#{1,6}\s+/gm, "")
    .replace(/!\[([^\]]*)\]\([^)]+\)/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[`*_>]/g, "")
    .replace(/\n{3,}/g, "\n\n")
    .trim();
}

function normalizeSummary(text = "") {
  return stripMarkdown(text).replace(/\s+/g, " ").trim();
}

function clampSummary(text = "", limit = 170) {
  const normalized = normalizeSummary(text);
  if (!normalized) return "View release notes on GitHub.";
  return normalized.length > limit ? `${normalized.slice(0, limit - 1).trimEnd()}…` : normalized;
}

function isLowValueSummary(text = "") {
  const normalized = normalizeSummary(text);

  if (!normalized) return true;
  if (normalized.length < 18) return true;
  if (/^(added|changed|fixed|removed|updated)$/i.test(normalized)) return true;
  if (/^(crona|prepare|release|version)\b/i.test(normalized)) return true;
  if (/^v?\d+\.\d+\.\d+(?:-[0-9A-Za-z-.]+)?$/i.test(normalized)) return true;

  return false;
}

function summaryFromReleaseBody(text = "") {
  const blocks = text.replace(/\r/g, "").split(/\n{2,}/).map((block) => block.trim()).filter(Boolean);

  for (const block of blocks) {
    const lines = block.split("\n").map((line) => line.trim()).filter(Boolean);
    const hasOnlyHeading = lines.length === 1 && /^#{1,6}\s+/.test(lines[0]);

    if (hasOnlyHeading) {
      continue;
    }

    const bullets = lines.filter((line) => /^[-*+]\s+/.test(line));

    if (bullets.length > 0) {
      for (const bullet of bullets) {
        const candidate = normalizeSummary(bullet.replace(/^[-*+]\s+/, ""));

        if (!isLowValueSummary(candidate)) {
          return clampSummary(candidate);
        }
      }

      continue;
    }

    const candidate = normalizeSummary(block);

    if (!isLowValueSummary(candidate)) {
      return clampSummary(candidate);
    }
  }

  return "View release notes on GitHub.";
}

function parseSemver(tag = ""): Semver | null {
  const match = tag.trim().match(/^v?(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z-.]+))?(?:\+[0-9A-Za-z-.]+)?$/);
  if (!match) return null;
  return {
    major: Number(match[1]),
    minor: Number(match[2]),
    patch: Number(match[3]),
    prerelease: Boolean(match[4]),
  };
}

function inferReleaseBump(currentTag: string, previousTag?: string): ReleaseBump {
  const current = parseSemver(currentTag);
  const previous = previousTag ? parseSemver(previousTag) : null;

  if (!current) {
    return "release";
  }

  if (!previous) {
    return current.prerelease ? "pre-release" : "release";
  }

  if (current.major > previous.major) return "major";
  if (current.minor > previous.minor) return "minor";
  if (current.patch > previous.patch) return "patch";

  return current.prerelease ? "pre-release" : "release";
}

async function loadReleases() {
  try {
    const response = await fetch(apiUrl, {
      headers: {
        Accept: "application/vnd.github+json",
        "User-Agent": "crona-site",
      },
    });

    if (!response.ok) {
      throw new Error(`GitHub releases request failed: ${response.status}`);
    }

    const data = (await response.json()) as GitHubRelease[];
    const cards = data
      .filter((release) => !release.draft)
      .map(
        (release): ReleaseCard => ({
          version: release.tag_name ?? release.name ?? "Release",
          title: release.tag_name ?? release.name ?? "Release",
          headline: release.name?.trim() || release.tag_name || "Release",
          url: release.html_url,
          publishedAt: release.published_at ? new Date(release.published_at) : null,
          status: release.prerelease ? "pre-release" : "stable",
          summary: summaryFromReleaseBody(release.body ?? ""),
          latest: false,
          latestStable: false,
          bump: "release",
        }),
      );

    return cards.map((release, index) => ({
      ...release,
      latest: index === 0,
      bump: inferReleaseBump(release.version, cards[index + 1]?.version),
    }));
  } catch {
    const local = (await getCollection("changelog")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    // Keep GitHub as the public source of truth; the local collection only keeps the page usable when the API is down.
    const cards = local.map(
      (entry): ReleaseCard => ({
        version: entry.data.version ?? entry.data.title,
        title: entry.data.version ?? entry.data.title,
        headline: entry.data.title,
        url: releasesUrl,
        publishedAt: entry.data.date ?? null,
        status: "stable",
        summary: entry.data.summary ?? "View release notes on GitHub.",
        latest: false,
        latestStable: false,
        bump: "release",
      }),
    );

    return cards.map((release, index) => ({
      ...release,
      latest: index === 0,
      bump: inferReleaseBump(release.version, cards[index + 1]?.version),
    }));
  }
}

const releases = await loadReleases();
const latestStableRelease = releases.find((release) => release.status === "stable") ?? null;
const visibleReleases = latestStableRelease ? releases : releases.filter((release) => release.status === "stable");
const releasesToRender = visibleReleases.map((release) => ({
  ...release,
  latestStable: latestStableRelease?.version === release.version,
}));
const siteUrl = Astro.site ?? new URL("https://crona.work");
const releasesPageUrl = new URL("/changelog/", siteUrl).href;
const itemList = releasesToRender.map((release, index) => ({
  "@type": "ListItem",
  position: index + 1,
  url: release.url,
  name: release.title,
}));
---

<BaseLayout
  title="Releases"
  pageTitle="Crona releases"
  description="See what changed, what shipped, and where to download the latest version."
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "Crona Releases",
      url: releasesPageUrl,
      isPartOf: {
        "@type": "WebSite",
        "@id": "https://crona.work/",
        name: "Crona",
      },
    },
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: "Crona release list",
      itemListOrder: "https://schema.org/ItemListOrderDescending",
      numberOfItems: itemList.length,
      itemListElement: itemList,
    },
  ]}
>
  <section class="container section">
    <div class="page-header flow measure">
      <p class="eyebrow">Releases</p>
      <h1>Crona releases</h1>
      <p>See what changed, what shipped, and where to download the latest version.</p>
    </div>

    <div class="releases-actions page-body">
      <a class="button" href={releasesUrl} rel="noreferrer">Open GitHub Releases</a>
      <a class="button button--secondary" href="/docs/install/">Install or update Crona</a>
    </div>

    <div class:list={{ "releases-timeline": true, "page-body": true, "is-empty": releasesToRender.length === 0 }}>
      {releasesToRender.length > 0 ? (
        releasesToRender.map((release) => (
          <article class:list={[
            "release-card",
            {
              "is-latest-stable": release.latestStable,
              "is-prerelease": release.status === "pre-release",
            },
          ]}>
            <div class="release-card__meta">
              <div class="release-card__badges">
                <span class:list={["release-card__badge", { "is-prerelease": release.status === "pre-release" }]}>{release.status === "pre-release" ? "Pre-release" : "Stable"}</span>
                {["major", "minor", "patch"].includes(release.bump) && <span class="release-card__badge is-bump">{release.bump.charAt(0).toUpperCase() + release.bump.slice(1)}</span>}
              </div>
              {release.publishedAt && <time datetime={release.publishedAt.toISOString()}>{dateFormatter.format(release.publishedAt)}</time>}
            </div>

            <div class="release-card__body flow">
              {release.latestStable && <p class="release-card__eyebrow">Latest stable release</p>}
              <h2>
                <a href={release.url} rel="noreferrer">
                  {release.title}
                </a>
              </h2>
              {release.headline && release.headline !== release.title && <p class="release-card__name">{release.headline}</p>}
              <p>{release.summary}</p>
            </div>

            <div class="release-card__actions">
              <a class="release-card__action" href={release.url} rel="noreferrer">
                View on GitHub
              </a>
              {release.latestStable && <a class="release-card__action" href="/docs/install/">Install or update Crona</a>}
            </div>
          </article>
        ))
      ) : (
        <article class="release-card">
          <div class="release-card__body flow">
            <h2>Release notes are temporarily unavailable</h2>
            <p>You can still check GitHub for the latest builds.</p>
          </div>
          <div class="release-card__actions">
            <a class="release-card__action" href={releasesUrl} rel="noreferrer">
              Open GitHub Releases
            </a>
          </div>
        </article>
      )}
    </div>

    <div class="releases-footer page-body">
      <a class="button" href={releasesUrl} rel="noreferrer">Open GitHub Releases</a>
    </div>
  </section>
</BaseLayout>
