---
import BaseLayout from "../layouts/BaseLayout.astro";
import "./_install/install.scss";
---

<BaseLayout
  title="Install"
  pageTitle="Crona install guide"
  description="Install Crona with the evergreen setup guide and use the releases page for current downloads."
>
  <section class="container section">
    <div class="page-header flow measure">
      <p class="eyebrow">Install</p>
      <h1>Install Crona</h1>
      <p>
        Use the stable website script for the quickest install path, then fall back to the docs for platform-specific
        setup and the releases page for downloadable artifacts.
      </p>
    </div>

    <div class="install-handoff page-body">
      <a class="install-handoff__card external-card" href="https://crona.work/install.sh" rel="noreferrer">
        <span>Stable path</span>
        <strong>Open install.sh</strong>
        <p>Use the website entrypoint for macOS and Linux installs without tracking release URLs.</p>
      </a>

      <a class="install-handoff__card external-card" href="https://crona.work/install.ps1" rel="noreferrer">
        <span>Stable path</span>
        <strong>Open install.ps1</strong>
        <p>Use the website entrypoint for Windows installs without tracking release URLs.</p>
      </a>

      <a class="install-handoff__card" href="/docs/install/">
        <span>Primary path</span>
        <strong>Open the install guide</strong>
        <p>Platform setup, runtime notes, shell completions, alerts, exports, and update channels.</p>
      </a>

      <a class="install-handoff__card external-card" href="/changelog/">
        <span>Downloads</span>
        <strong>Browse releases</strong>
        <p>Use the release list on the site, then jump to GitHub when you want the raw notes and artifacts.</p>
      </a>
    </div>
  </section>
</BaseLayout>
