---
import BaseLayout from "../layouts/BaseLayout.astro";
import "./_404/404.scss";
---

<BaseLayout title="Page Not Found" pageTitle="Page not found" description="The page you were looking for is not checked out." noindex hideChrome>
  <main class="not-found" aria-labelledby="not-found-title">
    <div class="not-found__matrix" data-not-found-matrix aria-hidden="true"></div>
    <section class="not-found__message">
      <p class="not-found__kicker">route not found</p>
      <h1 id="not-found-title">This page wandered off.</h1>
      <a class="not-found__home" href="/">Return to Crona <span aria-hidden="true">→</span></a>
    </section>
  </main>
</BaseLayout>

<script>
  const matrix = document.querySelector<HTMLElement>("[data-not-found-matrix]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const patterns = [
    ["10001", "10001", "10001", "11111", "00001", "00001", "00001"],
    ["01110", "10001", "10001", "10001", "10001", "10001", "01110"],
    ["10001", "10001", "10001", "11111", "00001", "00001", "00001"],
  ];
  type Dot = { element: HTMLSpanElement; x: number; y: number };
  type Digit = { pattern: string[]; x: number; y: number; targetX: number; targetY: number; nextMove: number; phase: number };
  let dots: Dot[] = [];
  let digits: Digit[] = [];
  let columns = 0;
  let rows = 0;
  let cellSize = 24;
  let animation = 0;
  const randomBetween = (min: number, max: number) => Math.floor(Math.random() * (max - min + 1)) + min;
  const resize = () => {
    if (!matrix) return;
    cellSize = window.innerWidth < 600 ? 24 : 30;
    matrix.style.setProperty("--grid-cell", `${cellSize}px`);
    columns = Math.ceil(window.innerWidth / cellSize);
    rows = Math.ceil(window.innerHeight / cellSize);
    matrix.style.setProperty("--grid-columns", String(columns));
    matrix.style.setProperty("--grid-rows", String(rows));
    matrix.replaceChildren();
    dots = [];
    for (let y = 0; y < rows; y += 1) for (let x = 0; x < columns; x += 1) {
      const dot = document.createElement("span");
      dot.className = "not-found__dot";
      dot.style.setProperty("--dot-x", String(x));
      dot.style.setProperty("--dot-y", String(y));
      matrix.append(dot);
      dots.push({ element: dot, x, y });
    }
    const scale = window.innerWidth < 600 ? 1 : 2;
    const glyphWidth = 5 * scale;
    const totalWidth = glyphWidth * 3 + scale * 4;
    const startX = Math.max(1, Math.floor((columns - totalWidth) / 2));
    const startY = Math.max(1, Math.floor((rows - 7 * scale) / 2));
    digits = patterns.map((pattern, index) => ({ pattern, x: startX + index * (glyphWidth + scale * 2), y: startY, targetX: startX + index * (glyphWidth + scale * 2), targetY: startY, nextMove: 0, phase: index * 1.8 }));
  };
  const draw = (time = 0) => {
    if (!matrix) return;
    const scale = window.innerWidth < 600 ? 1 : 2;
    const active = new Map<number, number>();
    digits.forEach((digit, digitIndex) => {
      if (!reducedMotion && time >= digit.nextMove) {
        digit.targetX = randomBetween(1, Math.max(1, columns - 5 * scale - 1));
        digit.targetY = randomBetween(1, Math.max(1, rows - 7 * scale - 1));
        digit.nextMove = time + randomBetween(1800, 4200);
      }
      if (!reducedMotion) { digit.x += (digit.targetX - digit.x) * .018; digit.y += (digit.targetY - digit.y) * .018; }
      digit.pattern.forEach((row, y) => [...row].forEach((value, x) => {
        if (value !== "1") return;
        for (let sy = 0; sy < scale; sy += 1) for (let sx = 0; sx < scale; sx += 1) {
          const gridX = Math.round(digit.x) + x * scale + sx;
          const gridY = Math.round(digit.y) + y * scale + sy;
          const dotIndex = gridY * columns + gridX;
          if (gridX >= 0 && gridX < columns && gridY >= 0 && gridY < rows) active.set(dotIndex, digitIndex);
        }
      }));
    });
    dots.forEach((dot, index) => {
      const digitIndex = active.get(index);
      dot.element.classList.toggle("is-lit", digitIndex !== undefined);
      if (digitIndex !== undefined) { dot.element.style.setProperty("--pulse", String(reducedMotion ? 1 : .72 + Math.sin(time * .004 + digitIndex * 1.8 + index) * .24)); dot.element.classList.toggle("is-middle", digitIndex === 1); }
      else dot.element.classList.remove("is-middle");
    });
    if (!reducedMotion) animation = requestAnimationFrame(draw);
  };
  resize(); draw();
  window.addEventListener("resize", resize);
  document.addEventListener("visibilitychange", () => { if (document.hidden) cancelAnimationFrame(animation); else if (!reducedMotion) animation = requestAnimationFrame(draw); });
</script>
