---
import "../styles/global/global.scss";
import SiteFooter from "../components/SiteFooter/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader/SiteHeader.astro";

interface Props {
  title: string;
  pageTitle?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  pageTitle,
  description = "Crona keeps issues, focus sessions, Momentum, alerts, and exports in one local-first system for developers.",
  canonical,
  image,
  noindex = false,
  ogType = "website",
  structuredData,
} = Astro.props;

const documentTitle = pageTitle ?? (title === "Crona" ? "Crona | Local-first work tracking for developers" : `${title} | Crona`);
const siteUrl = Astro.site ?? new URL("https://crona.work");
const canonicalUrl = canonical ? new URL(canonical, siteUrl).href : new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(image ?? "/social/crona-og.png", siteUrl).href;
const imageAlt = `${pageTitle ?? title} preview`;
const robotsContent = noindex ? "noindex,follow" : "index,follow";
const ambientHeatmapCells = Array.from({ length: 28 }, (_, index) => index);
const jsonLdEntries = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: documentTitle,
    description,
    url: canonicalUrl,
    isPartOf: {
      "@type": "WebSite",
      "@id": new URL("/", siteUrl).href,
      name: "Crona",
    },
  },
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="application-name" content="Crona" />
    <meta name="apple-mobile-web-app-title" content="Crona" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0c0b" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#0c0c0b" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Crona" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/x-icon" href="/logos/Logo Dark.ico" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/logos/Logo Dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/x-icon" href="/logos/Logo Light.ico" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="/logos/Logo Light.png" media="(prefers-color-scheme: light)" />
    <title>{documentTitle}</title>
    {jsonLdEntries.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <div class="site-shell">
      <div class="site-shell__ambient" aria-hidden="true">
        <div class="site-shell__ambient-header">
          <span>CRONA / TODAY</span>
          <span>LOCAL</span>
        </div>
        <div class="site-shell__ambient-body">
          <div class="site-shell__ambient-timeline">
            <div class="site-shell__ambient-heading">
              <span>FOCUS</span>
              <strong>42:18</strong>
            </div>
            <div class="site-shell__ambient-event">
              <time>09:00</time>
              <span>PLAN</span>
            </div>
            <div class="site-shell__ambient-event site-shell__ambient-event--active">
              <time>10:30</time>
              <span>DEEP WORK</span>
            </div>
            <div class="site-shell__ambient-event">
              <time>12:00</time>
              <span>REVIEW</span>
            </div>
          </div>
          <div class="site-shell__ambient-heatmap">
            <span class="site-shell__ambient-heatmap-label">MOMENTUM</span>
            <div class="site-shell__ambient-cells">
              {ambientHeatmapCells.map((index) => <span class:list={{ "is-active": [1, 4, 7, 8, 10, 13, 15, 16, 18, 21, 22, 24, 27].includes(index), "is-strong": [8, 16, 22].includes(index) }}></span>)}
            </div>
          </div>
        </div>
      </div>
      <div class="site-shell__content">
        <SiteHeader currentPath={Astro.url.pathname} />
        <main>
          <slot />
        </main>
        <SiteFooter />
      </div>
    </div>
  </body>
</html>
